<!DOCTYPE html><html lang="en"><head><%- include('../partials/head') %></head>
<body class="dashboard-body">
<%- include('../partials/sidebar-patient', {activePage:'dashboard'}) %>
<div class="main-content">
  <div class="top-bar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div class="page-title"><h4>Patient Dashboard</h4><p>Welcome back, <%= user.first_name %>!</p></div>
    <a href="/patient/book-appointment" class="btn btn-primary btn-sm"><i class="fas fa-calendar-plus me-1"></i>Book Appointment</a>
  </div>
  <div class="p-4">
    <%- include('../partials/flash') %>
    <!-- Welcome Banner -->
    <div class="welcome-banner mb-4">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <h4 class="fw-700 mb-1">Hello, <%= user.first_name %> <%= user.last_name %>!</h4>
          <p class="mb-0 opacity-75">Patient ID: <strong><%= patient.patient_code %></strong> &nbsp;|&nbsp;
            Blood: <strong><%= user.blood_group || 'Not set' %></strong> &nbsp;|&nbsp;
            Registered: <strong><%= new Date(patient.registration_date||patient.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></strong>
          </p>
        </div>
        <div class="col-lg-4 d-none d-lg-flex justify-content-end">
          <a href="/patient/book-appointment" class="btn btn-light btn-sm px-4"><i class="fas fa-calendar-plus me-2"></i>Book Appointment</a>
        </div>
      </div>
    </div>
    <!-- Stats -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3"><div class="stat-card-dash bg-white border"><div class="scd-icon text-primary"><i class="fas fa-calendar-check"></i></div><div class="scd-info"><h3><%= counts.total_appointments||0 %></h3><p>Total Visits</p></div></div></div>
      <div class="col-6 col-md-3"><div class="stat-card-dash bg-white border"><div class="scd-icon text-success"><i class="fas fa-calendar"></i></div><div class="scd-info"><h3><%= counts.upcoming||0 %></h3><p>Upcoming</p></div></div></div>
      <div class="col-6 col-md-3"><div class="stat-card-dash bg-white border"><div class="scd-icon text-info"><i class="fas fa-clipboard-check"></i></div><div class="scd-info"><h3><%= counts.completed||0 %></h3><p>Completed</p></div></div></div>
      <div class="col-6 col-md-3"><div class="stat-card-dash bg-white border"><div class="scd-icon text-warning"><i class="fas fa-rupee-sign"></i></div><div class="scd-info"><h3>₹<%= parseFloat(counts.pending_dues||0).toLocaleString() %></h3><p>Pending Dues</p></div></div></div>
    </div>
    <div class="row g-4">
      <!-- Upcoming Appointments -->
      <div class="col-lg-8">
        <div class="page-card">
          <div class="page-card-header"><h5 class="mb-0"><i class="fas fa-calendar text-primary me-2"></i>Upcoming Appointments</h5><a href="/patient/appointments" class="btn btn-sm btn-outline-primary">View All</a></div>
          <div class="page-card-body">
            <% if(upcomingAppts.length){ upcomingAppts.forEach(a => { %>
            <div class="appointment-card mb-3">
              <div class="appt-date-badge">
                <div class="day"><%= new Date(a.appointment_date).getDate() %></div>
                <div class="month"><%= new Date(a.appointment_date).toLocaleString('en-IN',{month:'short'}) %></div>
              </div>
              <div class="flex-grow-1">
                <div class="fw-600">Dr. <%= a.doctor_name %></div>
                <div class="small text-muted"><%= a.specialization %> · <%= a.dept_name %></div>
                <div class="small text-muted"><i class="fas fa-clock me-1"></i><%= a.appointment_time %> &nbsp;<span class="badge status-<%= a.status.toLowerCase().replace(/[\s-]/g,'') %>"><%= a.status %></span></div>
              </div>
              <div class="text-end">
                <div class="small fw-600 text-primary"><%= a.appointment_code %></div>
                <form action="/patient/appointments/<%= a.appointment_id %>/cancel" method="POST" class="mt-1" onsubmit="return confirm('Cancel this appointment?')">
                  <input type="hidden" name="reason" value="Cancelled by patient">
                  <button type="submit" class="btn btn-xs btn-outline-danger">Cancel</button>
                </form>
              </div>
            </div>
            <% }) } else { %>
            <div class="text-center text-muted py-4">
              <i class="fas fa-calendar-plus fa-2x mb-2 d-block opacity-25"></i>
              <p class="mb-3">No upcoming appointments</p>
              <a href="/patient/book-appointment" class="btn btn-primary btn-sm">Book Now</a>
            </div>
            <% } %>
          </div>
        </div>
      </div>
      <!-- Notifications & Bills -->
      <div class="col-lg-4">
        <div class="page-card mb-3">
          <div class="page-card-header"><h5 class="mb-0"><i class="fas fa-bell text-warning me-2"></i>Notifications</h5></div>
          <div class="page-card-body p-0">
            <% if(notifications.length){ notifications.forEach(n=>{ %>
            <div class="notif-item unread">
              <div class="fw-600" style="font-size:13px"><%= n.title %></div>
              <div class="text-muted small"><%= n.message.substring(0,70) %>…</div>
            </div>
            <% }) } else { %><div class="p-3 text-center text-muted small">No new notifications</div><% } %>
          </div>
        </div>
        <div class="page-card">
          <div class="page-card-header"><h5 class="mb-0"><i class="fas fa-receipt text-danger me-2"></i>Pending Bills</h5><a href="/patient/bills" class="btn btn-xs btn-outline-danger">View All</a></div>
          <div class="page-card-body p-0">
            <% if(bills.length){ bills.forEach(b=>{ %>
            <div class="patient-list-item">
              <div class="flex-grow-1"><div class="small fw-600"><%= b.bill_number %></div><div class="text-muted" style="font-size:11px"><%= new Date(b.bill_date).toLocaleDateString('en-IN') %></div></div>
              <div class="text-end"><div class="small fw-700 text-danger">₹<%= parseFloat(b.balance_amount).toLocaleString() %></div><span class="badge status-<%= b.payment_status.toLowerCase() %>"><%= b.payment_status %></span></div>
            </div>
            <% }) } else { %><div class="p-3 text-center text-muted small"><i class="fas fa-check-circle text-success me-1"></i>No pending dues</div><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
