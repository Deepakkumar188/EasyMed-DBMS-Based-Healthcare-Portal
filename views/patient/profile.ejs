<!DOCTYPE html><html lang="en"><head><%- include('../partials/head') %></head>
<body class="dashboard-body">
<%- include('../partials/sidebar-patient', {activePage:'profile'}) %>
<div class="main-content">
  <div class="top-bar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div class="page-title"><h4>My Profile</h4><p>Manage your health information</p></div>
  </div>
  <div class="p-4">
    <%- include('../partials/flash') %>
    <% if(errors && errors.length){ %><div class="alert alert-danger"><ul class="mb-0 ps-3"><% errors.forEach(e=>{%><li><%=e.msg%></li><%})%></ul></div><% } %>
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="page-card text-center">
          <div class="page-card-body">
            <div class="doc-avatar mx-auto mb-3" style="width:80px;height:80px;font-size:1.8rem"><%= patient.first_name[0] %><%= patient.last_name[0] %></div>
            <h5 class="fw-700"><%= patient.first_name %> <%= patient.last_name %></h5>
            <p class="text-muted small"><code><%= patient.patient_code %></code></p>
            <% if(patient.blood_group){ %><span class="badge bg-danger me-1"><%= patient.blood_group %></span><% } %>
            <span class="badge bg-<%= patient.gender==='Male'?'primary':'pink' %>"><%= patient.gender %></span>
            <hr>
            <div class="d-flex justify-content-center gap-3 mt-2">
              <div class="text-center"><div class="small text-muted">Age</div><div class="fw-700"><%= patient.date_of_birth ? Math.floor((Date.now()-new Date(patient.date_of_birth))/(365.25*86400000)) : '—' %></div></div>
              <div class="text-center"><div class="small text-muted">City</div><div class="fw-700"><%= patient.city || '—' %></div></div>
            </div>
            <% if(patient.insurance_provider){ %><div class="mt-3 p-2 bg-light rounded small"><i class="fas fa-shield-alt text-success me-1"></i><%= patient.insurance_provider %></div><% } %>
          </div>
        </div>
      </div>
      <div class="col-lg-8">
        <div class="page-card">
          <div class="page-card-header"><h5 class="mb-0">Edit Profile</h5></div>
          <div class="page-card-body">
            <form action="/patient/profile" method="POST">
              <div class="form-section-title">Personal Information</div>
              <div class="row g-3 mt-1">
                <div class="col-md-6"><label class="form-label">First Name</label><input type="text" class="form-control" value="<%= patient.first_name %>" disabled></div>
                <div class="col-md-6"><label class="form-label">Last Name</label><input type="text" class="form-control" value="<%= patient.last_name %>" disabled></div>
                <div class="col-md-6"><label class="form-label">Email</label><input type="email" class="form-control" value="<%= patient.email %>" disabled></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input type="tel" name="phone" class="form-control" value="<%= patient.phone %>"></div>
                <div class="col-md-4"><label class="form-label">Date of Birth</label><input type="date" class="form-control" value="<%= patient.date_of_birth ? new Date(patient.date_of_birth).toISOString().split('T')[0] : '' %>" disabled></div>
                <div class="col-md-4"><label class="form-label">Gender</label><input type="text" class="form-control" value="<%= patient.gender %>" disabled></div>
                <div class="col-md-4"><label class="form-label">Blood Group</label>
                  <select name="blood_group" class="form-select">
                    <option value="">Unknown</option>
                    <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bg=>{%><option value="<%=bg%>" <%=patient.blood_group===bg?'selected':''%>><%=bg%></option><%})%>
                  </select>
                </div>
              </div>
              <div class="form-section-title mt-4">Address</div>
              <div class="row g-3 mt-1">
                <div class="col-12"><label class="form-label">Address</label><input type="text" name="address" class="form-control" value="<%= patient.address %>"></div>
                <div class="col-md-4"><label class="form-label">City</label><input type="text" name="city" class="form-control" value="<%= patient.city %>"></div>
                <div class="col-md-4"><label class="form-label">State</label><input type="text" name="state" class="form-control" value="<%= patient.state %>"></div>
                <div class="col-md-4"><label class="form-label">Pincode</label><input type="text" name="pincode" class="form-control" value="<%= patient.pincode %>"></div>
              </div>
              <div class="form-section-title mt-4">Emergency Contact</div>
              <div class="row g-3 mt-1">
                <div class="col-md-4"><label class="form-label">Name</label><input type="text" name="emergency_name" class="form-control" value="<%= patient.emergency_contact_name %>"></div>
                <div class="col-md-4"><label class="form-label">Phone</label><input type="tel" name="emergency_phone" class="form-control" value="<%= patient.emergency_contact_phone %>"></div>
                <div class="col-md-4"><label class="form-label">Relation</label><input type="text" name="emergency_relation" class="form-control" value="<%= patient.emergency_contact_relation %>"></div>
              </div>
              <div class="form-section-title mt-4">Medical Information</div>
              <div class="row g-3 mt-1">
                <div class="col-md-6"><label class="form-label">Occupation</label><input type="text" name="occupation" class="form-control" value="<%= patient.occupation %>"></div>
                <div class="col-md-6"><label class="form-label">Known Allergies</label><input type="text" name="known_allergies" class="form-control" value="<%= patient.known_allergies %>"></div>
                <div class="col-md-6"><label class="form-label">Chronic Conditions</label><textarea name="chronic_conditions" class="form-control" rows="2"><%= patient.chronic_conditions %></textarea></div>
                <div class="col-md-6"><label class="form-label">Current Medications</label><textarea name="current_medications" class="form-control" rows="2"><%= patient.current_medications %></textarea></div>
              </div>
              <div class="mt-4"><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Save Changes</button></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
