<!DOCTYPE html><html lang="en"><head><%- include('../partials/head') %></head>
<body class="dashboard-body">
<%- include('../partials/sidebar-patient', {activePage:'appointments'}) %>
<div class="main-content">
  <div class="top-bar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div class="page-title"><h4>My Appointments</h4><p><%= appointments.length %> total appointments</p></div>
    <a href="/patient/book-appointment" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Book New</a>
  </div>
  <div class="p-4">
    <%- include('../partials/flash') %>
    <% const upcoming = appointments.filter(a=>['Scheduled','Confirmed','Checked-In','In-Progress'].includes(a.status));
       const history  = appointments.filter(a=>['Completed','Cancelled','No-Show'].includes(a.status)); %>
    <ul class="nav nav-tabs mb-3">
      <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#upcoming">Upcoming (<%= upcoming.length %>)</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#history">History (<%= history.length %>)</a></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane fade show active" id="upcoming">
        <% if(upcoming.length){ upcoming.forEach(a=>{ %>
        <div class="appointment-card mb-3">
          <div class="appt-date-badge">
            <div class="day"><%= new Date(a.appointment_date).getDate() %></div>
            <div class="month"><%= new Date(a.appointment_date).toLocaleString('en-IN',{month:'short'}) %></div>
          </div>
          <div class="flex-grow-1 ms-2">
            <div class="fw-600">Dr. <%= a.doctor_name %></div>
            <div class="small text-muted"><%= a.specialization %> · <%= a.dept_name %></div>
            <div class="small text-muted mt-1">
              <i class="fas fa-clock me-1"></i><%= a.appointment_time %> &nbsp;
              <i class="fas fa-tag me-1 ms-2"></i><%= a.appointment_type %> &nbsp;
              <i class="fas fa-rupee-sign me-1 ms-2"></i><%= a.consultation_fee %>
            </div>
            <% if(a.reason_for_visit){ %><div class="small text-muted"><i class="fas fa-notes-medical me-1"></i><%= a.reason_for_visit.substring(0,60) %>…</div><% } %>
          </div>
          <div class="text-end">
            <code class="small d-block mb-1"><%= a.appointment_code %></code>
            <span class="badge status-<%= a.status.toLowerCase().replace(/[\s-]/g,'') %> d-block mb-2"><%= a.status %></span>
            <% if(!['Completed','Cancelled','No-Show'].includes(a.status)){ %>
            <form action="/patient/appointments/<%= a.appointment_id %>/cancel" method="POST" onsubmit="return confirm('Cancel appointment?')">
              <input type="hidden" name="reason" value="Cancelled by patient">
              <button type="submit" class="btn btn-xs btn-outline-danger">Cancel</button>
            </form>
            <% } %>
          </div>
        </div>
        <% }) } else { %>
        <div class="text-center text-muted py-5"><i class="fas fa-calendar-check fa-3x mb-3 d-block opacity-25"></i><p>No upcoming appointments</p><a href="/patient/book-appointment" class="btn btn-primary">Book Now</a></div>
        <% } %>
      </div>
      <div class="tab-pane fade" id="history">
        <div class="page-card">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light"><tr><th>Code</th><th>Doctor</th><th>Date</th><th>Type</th><th>Status</th><th>Fee</th><th>Payment</th></tr></thead>
              <tbody>
                <% history.forEach(a=>{ %>
                <tr>
                  <td><code class="small"><%= a.appointment_code %></code></td>
                  <td><div class="small"><div class="fw-600">Dr. <%= a.doctor_name %></div><div class="text-muted" style="font-size:11px"><%= a.specialization %></div></div></td>
                  <td><small><%= new Date(a.appointment_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></small></td>
                  <td><span class="badge bg-light text-dark"><%= a.appointment_type %></span></td>
                  <td><span class="badge status-<%= a.status.toLowerCase().replace(/[\s-]/g,'') %>"><%= a.status %></span></td>
                  <td>₹<%= a.consultation_fee %></td>
                  <td><span class="badge status-<%= a.payment_status.toLowerCase() %>"><%= a.payment_status %></span></td>
                </tr>
                <% }) %>
                <% if(!history.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No appointment history yet</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
