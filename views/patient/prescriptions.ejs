<!DOCTYPE html><html lang="en"><head><%- include('../partials/head') %></head>
<body class="dashboard-body">
<%- include('../partials/sidebar-patient', {activePage:'prescriptions'}) %>
<div class="main-content">
  <div class="top-bar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div class="page-title"><h4>Prescriptions</h4><p><%= prescriptions.length %> prescriptions issued</p></div>
  </div>
  <div class="p-4">
    <%- include('../partials/flash') %>
    <% if(prescriptions.length){ prescriptions.forEach(pr=>{ %>
    <div class="rx-card mb-4">
      <div class="rx-header">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="fw-700 mb-0"><i class="fas fa-prescription me-2"></i><%= pr.prescription_code %></div>
            <div class="small opacity-75">Dr. <%= pr.doctor_name %> &nbsp;·&nbsp; <%= new Date(pr.prescription_date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}) %></div>
          </div>
          <span class="badge <%= pr.is_dispensed?'bg-success':'bg-warning text-dark' %>"><%= pr.is_dispensed?'Dispensed':'Pending' %></span>
        </div>
      </div>
      <% if(pr.diagnosis){ %><div class="mb-3"><label class="info-item"><label>Diagnosis</label></label><p class="small mb-0"><%= pr.diagnosis %></p></div><% } %>
      <h6 class="fw-600 mb-2"><i class="fas fa-pills me-2 text-success"></i>Medications</h6>
      <% if(pr.items && pr.items.length){ pr.items.forEach(item=>{ %>
      <div class="medicine-item">
        <div class="med-icon"><i class="fas fa-capsules"></i></div>
        <div class="flex-grow-1">
          <div class="fw-600 small"><%= item.medicine_name %><% if(item.generic_name){ %> <span class="text-muted fw-400">(<%= item.generic_name %>)</span><% } %></div>
          <div class="text-muted small">
            <span class="me-3"><i class="fas fa-dot-circle me-1 text-primary"></i><%= item.dosage || '—' %></span>
            <span class="me-3"><i class="fas fa-redo me-1 text-success"></i><%= item.frequency || '—' %></span>
            <span><i class="fas fa-calendar me-1 text-warning"></i><%= item.duration || '—' %></span>
          </div>
          <% if(item.instructions){ %><div class="text-info small"><i class="fas fa-info-circle me-1"></i><%= item.instructions %></div><% } %>
        </div>
        <div class="text-end"><span class="badge bg-light text-dark">Qty: <%= item.quantity %></span></div>
      </div>
      <% }) } else { %><div class="text-muted small">No medications listed</div><% } %>
      <% if(pr.notes){ %><div class="mt-3 small text-muted"><i class="fas fa-sticky-note me-1"></i><em><%= pr.notes %></em></div><% } %>
    </div>
    <% }) } else { %>
    <div class="text-center text-muted py-5"><i class="fas fa-prescription-bottle-alt fa-3x mb-3 d-block opacity-25"></i><p>No prescriptions issued yet</p></div>
    <% } %>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
