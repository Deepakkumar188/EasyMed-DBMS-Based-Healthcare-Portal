<!DOCTYPE html><html lang="en"><head><%- include('../partials/head') %></head>
<body class="dashboard-body">
<%- include('../partials/sidebar-admin', {activePage:'appointments'}) %>
<div class="main-content">
  <div class="top-bar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div class="page-title"><h4>Appointments</h4><p>View and manage all appointments</p></div>
  </div>
  <div class="p-4">
    <%- include('../partials/flash') %>
    <div class="page-card mb-3">
      <div class="page-card-body">
        <form class="row g-2 align-items-end" method="GET">
          <div class="col-md-3"><label class="form-label small">Filter by Date</label><input type="date" name="date" class="form-control form-control-sm" value="<%= date %>"></div>
          <div class="col-md-3"><label class="form-label small">Filter by Status</label>
            <select name="status" class="form-select form-select-sm">
              <option value="">All Statuses</option>
              <% ['Scheduled','Confirmed','Checked-In','In-Progress','Completed','Cancelled','No-Show'].forEach(s=>{ %>
              <option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-auto"><button class="btn btn-primary btn-sm">Filter</button></div>
          <div class="col-auto"><a href="/admin/appointments" class="btn btn-outline-secondary btn-sm">Reset</a></div>
        </form>
      </div>
    </div>
    <div class="page-card">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light"><tr><th>Appt Code</th><th>Patient</th><th>Doctor</th><th>Department</th><th>Date & Time</th><th>Type</th><th>Status</th><th>Fee</th><th>Payment</th></tr></thead>
          <tbody>
            <% appointments.forEach(a => { %>
            <tr>
              <td><code class="small"><%= a.appointment_code %></code></td>
              <td><div class="d-flex align-items-center gap-2"><div class="mini-avatar"><%= a.patient_name[0] %></div><div><div class="fw-600 small"><%= a.patient_name %></div><div class="text-muted" style="font-size:11px"><%= a.patient_code %></div></div></div></td>
              <td><div class="small"><div class="fw-600">Dr. <%= a.doctor_name %></div><div class="text-muted" style="font-size:11px"><%= a.specialization %></div></div></td>
              <td><span class="small"><%= a.dept_name || '—' %></span></td>
              <td><div class="small"><%= new Date(a.appointment_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %><br><span class="text-muted"><%= a.appointment_time %></span></div></td>
              <td><span class="badge bg-light text-dark"><%= a.appointment_type %></span></td>
              <td><span class="badge status-<%= a.status.toLowerCase().replace(/[\s-]/g,'') %>"><%= a.status %></span></td>
              <td>₹<%= a.consultation_fee %></td>
              <td><span class="badge status-<%= a.payment_status.toLowerCase() %>"><%= a.payment_status %></span></td>
            </tr>
            <% }) %>
            <% if(!appointments.length){ %><tr><td colspan="9" class="text-center text-muted py-5"><i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>No appointments found</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
