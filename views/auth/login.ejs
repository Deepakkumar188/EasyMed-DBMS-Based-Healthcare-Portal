<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="auth-body">
<div class="auth-container">
  <div class="auth-left d-none d-lg-flex">
    <div class="auth-left-content">
      <div class="auth-brand"><i class="fas fa-heartbeat"></i> EasyMed</div>
      <h2>Welcome Back!</h2>
      <p>Access your health records, appointments, and care — all in one place.</p>
      <div class="auth-features">
        <div class="af-item"><i class="fas fa-calendar-check"></i> Book appointments instantly</div>
        <div class="af-item"><i class="fas fa-file-medical"></i> Access medical records</div>
        <div class="af-item"><i class="fas fa-prescription"></i> View prescriptions</div>
        <div class="af-item"><i class="fas fa-flask"></i> Check lab results</div>
      </div>
    </div>
  </div>
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="auth-form-header">
        <a href="/" class="auth-brand-sm"><i class="fas fa-heartbeat"></i> EasyMed</a>
        <h3>Sign In</h3>
        <p>Enter your credentials to access your account</p>
      </div>
      <% if (error && error.length) { %><div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div><% } %>
      <% if (success && success.length) { %><div class="alert alert-success"><i class="fas fa-check-circle me-2"></i><%= success %></div><% } %>
      <form action="/auth/login" method="POST" class="auth-form">
        <div class="mb-3">
          <label class="form-label">Email Address</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
            <input type="email" name="email" class="form-control" placeholder="you@email.com" required autofocus>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label d-flex justify-content-between">Password <a href="#" class="small text-primary">Forgot?</a></label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="password" id="loginPass" class="form-control" placeholder="Your password" required>
            <button type="button" class="btn btn-outline-secondary" onclick="togglePass('loginPass',this)"><i class="fas fa-eye"></i></button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 btn-lg">Sign In <i class="fas fa-arrow-right ms-2"></i></button>
      </form>
      <div class="auth-divider"><span>Demo Credentials</span></div>
      <div class="demo-creds">
        <div class="demo-btn" onclick="fillCreds('admin@easymed.com','Admin@123')"><span class="badge bg-danger me-2">Admin</span>admin@easymed.com</div>
        <div class="demo-btn" onclick="fillCreds('rajesh.sharma@easymed.com','Doctor@123')"><span class="badge bg-primary me-2">Doctor</span>rajesh.sharma@easymed.com</div>
        <div class="demo-btn" onclick="fillCreds('arjun.mehta@email.com','Patient@123')"><span class="badge bg-success me-2">Patient</span>arjun.mehta@email.com</div>
      </div>
      <p class="text-center mt-4 text-muted">No account? <a href="/auth/register" class="text-primary fw-semibold">Register as Patient</a></p>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script>
function fillCreds(e,p){document.querySelector('[name=email]').value=e;document.querySelector('[name=password]').value=p;}
function togglePass(id,btn){const f=document.getElementById(id);f.type=f.type==='password'?'text':'password';btn.innerHTML=f.type==='password'?'<i class="fas fa-eye"></i>':'<i class="fas fa-eye-slash"></i>';}
</script>
</body></html>
