    <a href="/patient/lab-results" class="sidebar-link <%= locals.activePage==='lab'?'active':'' %>"><i class="fas fa-flask"></i> Lab Results</a>
    <div class="sidebar-section">BILLING</div>
    <a href="/patient/bills" class="sidebar-link <%= locals.activePage==='bills'?'active':'' %>"><i class="fas fa-receipt"></i> Bills & Payments</a>
