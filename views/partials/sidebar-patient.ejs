    <a href="/patient/book-appointment" class="sidebar-link <%= locals.activePage==='book'?'active':'' %>"><i class="fas fa-calendar-plus"></i> Book Appointment</a>
    <a href="/patient/appointments" class="sidebar-link <%= locals.activePage==='appointments'?'active':'' %>"><i class="fas fa-calendar-check"></i> My Appointments</a>
