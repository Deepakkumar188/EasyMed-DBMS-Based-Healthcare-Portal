  <div class="sidebar-brand"><i class="fas fa-heartbeat"></i> Easy<span>Med</span></div>
  <div class="sidebar-user">
    <div class="user-avatar"><%= user.first_name[0] %><%= user.last_name[0] %></div>
    <div class="user-info">
      <div class="user-name"><%= user.first_name %> <%= user.last_name %></div>
      <div class="user-role">Patient</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/patient/dashboard" class="sidebar-link <%= locals.activePage==='dashboard'?'active':'' %>"><i class="fas fa-th-large"></i> Dashboard</a>
