<!DOCTYPE html><html lang="en"><head><%- include('partials/head') %></head>
<body><%- include('partials/navbar') %>
<section class="py-5 bg-gradient-primary text-white" style="background:linear-gradient(135deg,#0d1b4b,#0066cc)">
  <div class="container text-center py-4">
    <h1 class="fw-bold">About EasyMed</h1>
    <p class="opacity-75">Redefining healthcare delivery through technology</p>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="row align-items-center g-5 mb-5">
      <div class="col-lg-6">
        <span class="section-tag">Our Story</span>
        <h2 class="section-title mt-2">Healthcare Made Accessible for Everyone</h2>
        <p class="text-muted">EasyMed was founded in 2020 with a single mission: to make quality healthcare accessible, affordable, and efficient for every patient. We bridge the gap between patients and healthcare professionals using a powerful, database-driven platform.</p>
        <p class="text-muted">Our comprehensive portal handles everything from patient registration and appointment scheduling to medical records, lab results, prescriptions, and billing — all in one secure, HIPAA-aligned system.</p>
      </div>
      <div class="col-lg-6">
        <div class="stats-grid">
          <div class="stat-card bg-primary text-white"><h2>50K+</h2><p>Patients Served</p></div>
          <div class="stat-card bg-white"><h2 class="text-primary">500+</h2><p>Specialist Doctors</p></div>
          <div class="stat-card bg-white"><h2 class="text-success">15+</h2><p>Departments</p></div>
          <div class="stat-card bg-success text-white"><h2>98%</h2><p>Satisfaction Rate</p></div>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-md-4"><div class="dept-card text-center p-4"><div class="dept-icon mx-auto"><i class="fas fa-bullseye"></i></div><h5>Our Mission</h5><p class="text-muted small">To deliver seamless, technology-powered healthcare solutions that prioritize patient well-being and clinical efficiency.</p></div></div>
      <div class="col-md-4"><div class="dept-card text-center p-4"><div class="dept-icon mx-auto"><i class="fas fa-eye"></i></div><h5>Our Vision</h5><p class="text-muted small">To become India's most trusted digital healthcare platform, connecting millions of patients with world-class medical professionals.</p></div></div>
      <div class="col-md-4"><div class="dept-card text-center p-4"><div class="dept-icon mx-auto"><i class="fas fa-heart"></i></div><h5>Our Values</h5><p class="text-muted small">Compassion, integrity, innovation, and excellence in everything we do — from technology to patient care.</p></div></div>
    </div>
  </div>
</section>
<section class="py-5 bg-light">
  <div class="container">
    <div class="section-header text-center mb-5"><h2 class="section-title">Our Technology Stack</h2></div>
    <div class="row g-3 text-center">
      <% [['fab fa-node-js','Node.js','Runtime'],['fas fa-database','MySQL','Database'],['fab fa-js','JavaScript','Language'],['fab fa-html5','HTML5','Markup'],['fab fa-css3','CSS3','Styling'],['fas fa-layer-group','Bootstrap 5','UI Framework']].forEach(t=>{ %>
      <div class="col-md-2 col-4"><div class="dept-card p-3"><div class="dept-icon mx-auto mb-2"><i class="<%= t[0] %>"></i></div><div class="fw-600 small"><%= t[1] %></div><div class="text-muted" style="font-size:11px"><%= t[2] %></div></div></div>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body></html>
